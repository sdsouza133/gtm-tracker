# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://gt:gt@localhost:5432/gt_dev
# 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Sign in with Google. The OAuth client ID is public (Google's button needs it in the page); make one in Google Cloud
# Console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application, with this site's
# address (and http://localhost:5173 for local work) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# The Google accounts allowed in, comma-separated. Nobody else can sign in with Google.
ALLOWED_EMAILS=
# Optional: a password as well (or instead), as an argon2 hash:
#   echo 'your password' | uv run python -m app.cli hash-password
PASSWORD_HASH=
# How long a sign-in lasts, in days (1-365).
# SESSION_DAYS=180
# Or run with no login at all (anyone with the address gets in). Off unless set.
# OPEN_ACCESS=true
SECURE_COOKIES=false
TIMEZONE=America/Toronto
# Optional: lets automation (the daily refresh) call the API with "Authorization: Bearer <API_TOKEN>"
API_TOKEN=
