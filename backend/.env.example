# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://gt:gt@localhost:5432/gt_dev
# 32+ random characters: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The argon2 hash of your password: echo 'your password' | uv run python -m app.cli hash-password
PASSWORD_HASH=
SECURE_COOKIES=false
TIMEZONE=America/Toronto
# Optional: lets automation (the daily refresh) call the API with "Authorization: Bearer <API_TOKEN>"
API_TOKEN=
